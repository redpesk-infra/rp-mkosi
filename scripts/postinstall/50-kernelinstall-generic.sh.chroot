#!/bin/bash

# Generated grub.cfg for automatically booting redpesk for generic image

# Options:
# KERNEL_CMDLINE_EXTRA: Environnement variable to add extra cmdline options

kernelver=$(rpm -q --qf '%{VERSION}-%{RELEASE}.%{ARCH}\n' kernel)
arch=$(rpm -q --qf '%{ARCH}\n' kernel)

echo "Grub cfg generation for kernelver=$kernelver arch=$arch"

# grub smbios module install
mkdir -p /boot/efi/EFI/redpesk/$arch-efi/
cp $(find /usr/lib/grub -name 'smbios.mod') /boot/efi/EFI/redpesk/$arch-efi/

cat << EOF > /boot/efi/EFI/redpesk/grub.cfg
# Automatically generated by RedPesk postinstall mkosi script

set default=0
set timeout=5

insmod part_gpt
insmod ext2
insmod search
insmod search_fs_label

# set right console option
insmod smbios
smbios --type 1 --get-string 4 --set system_manufacturer
smbios --type 1 --get-string 5 --set board_name

if [ "\$system_manufacturer" = "QEMU" ]; then
  set redoptions=console=ttyS0,115200
elif ["\$board_name" = "UP-ADLN01" ]; then
  # this is up7000
  set redoptions=console=ttyS1,115200
else
  set redoptions=console=ttyS0,115200
fi

# add RedPesk entry
menuentry "RedPesk ${REDPESK_DISTRO}" {
    search --no-floppy --label --set=root BOOT

    linux /redpesk/${kernelver}/linux root=LABEL=ROOT \$redoptions $KERNEL_CMDLINE_EXTRA
    initrd /redpesk/${kernelver}/initrd

}
EOF
